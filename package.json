{
	"name": "vehicle-workshop",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node tools/serve-build.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=chromium",
		"test:coverage": "vitest run --coverage",
		"test:pwa": "pnpm build && playwright test --project=pwa",
		"icons": "node tools/make-icons.mjs",
		"vehicle:convert": "node scripts/vehicle-convert.mjs",
		"vehicle:preview": "node scripts/preview-art.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@vite-pwa/sveltekit": "^2.0.2",
		"@vitest/coverage-v8": "^5.1.0",
		"jsdom": "^31.0.1",
		"magicast": "^0.5.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	}
}
